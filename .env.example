# Copie este arquivo para .env e troque os valores. O .env NUNCA vai para o Git.
# Na Azure estas variáveis ficam em: App Service > Configurações > Variáveis de ambiente.

# String de conexão do Azure SQL Database (formato ADO.NET, como o portal mostra
# em Banco > Cadeias de conexão). Use o usuário da APLICAÇÃO (app_mural), não o
# administrador. Mantenha as aspas. Se a senha tiver ";", coloque-a entre chaves: {sen;ha}
DATABASE_URL="Server=tcp:SERVIDOR.database.windows.net,1433;Initial Catalog=BANCO;User ID=app_mural;Password=SENHA_FALSA;Encrypt=True;Connection Timeout=30;"

# Porta local (na Azure o App Service define a PORT sozinho)
PORT=3000
